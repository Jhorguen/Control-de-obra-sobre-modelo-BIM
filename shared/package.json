{
  "name": "@bim/shared",
  "version": "0.1.0",
  "private": true,
  "description": "API contract shared by client and server: Zod schemas and inferred types.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./extraction": {
      "types": "./dist/extraction/index.d.ts",
      "development": "./src/extraction/index.ts",
      "default": "./dist/extraction/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "web-ifc": "0.0.77",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  }
}
