{
  "name": "control-obra-bim",
  "version": "0.1.0",
  "private": true,
  "description": "Control de obra sobre modelo BIM: visor IFC, cantidades, presupuesto y avance de obra.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w @bim/server",
    "dev:client": "npm run dev -w @bim/client",
    "build": "npm run build -w @bim/shared && npm run build -w @bim/server && npm run build -w @bim/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "web-ifc": "0.0.77"
  }
}
