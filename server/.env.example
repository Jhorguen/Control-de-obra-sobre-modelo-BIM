# Copy to .env for local development. Never commit .env.

# PostgreSQL started with `docker compose up -d` (see docker-compose.yml)
DATABASE_URL="postgresql://bim:bim@localhost:5432/bim?schema=public"

# HTTP port of the API
PORT=3000

# Frontend origins allowed to call the API from the browser (comma-separated).
# Not needed locally: Vite proxies /api. In production: https://your-app.vercel.app
CORS_ORIGINS=

# Database used by the API tests (they truncate tables, never point this to real data)
TEST_DATABASE_URL="postgresql://bim:bim@localhost:5432/bim_test?schema=public"
