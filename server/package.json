{
  "name": "@bim/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=development prisma/seed.ts"
  },
  "dependencies": {
    "@bim/shared": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@thatopen/fragments": "3.6.1",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@types/three": "0.187.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "web-ifc": "0.0.77"
  }
}
